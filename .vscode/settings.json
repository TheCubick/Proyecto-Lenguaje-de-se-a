{
    // Usa siempre el Python del entorno virtual del proyecto
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,

    // PowerShell con ExecutionPolicy Bypass para que Activate.ps1 no se bloquee
    "terminal.integrated.profiles.windows": {
        "PowerShell (venv)": {
            "source": "PowerShell",
            "args": ["-NoExit", "-ExecutionPolicy", "Bypass"]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (venv)",

    "files.exclude": {
        "**/__pycache__": true
    }
}
